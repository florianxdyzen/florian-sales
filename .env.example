# Florian Sales — copy to .env.local
# New Supabase project only.
# Do not reuse Florian inventory keys, FRS keys, or Recare / KT keys.
# Leave the schema unset so the client uses public.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron — Authorization: Bearer <secret> on /api/cron/reminders
CRON_SECRET=change-me-long-random

# Evening daily report — /api/cron/daily-report at 13:30 UTC (≈19:00 IST)
DAILY_REPORT_TO=ops@example.com
# RESEND_API_KEY=re_xxx
# DAILY_REPORT_FROM=Florian Reports <reports@yourdomain.com>
